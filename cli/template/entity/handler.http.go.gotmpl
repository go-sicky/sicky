// HTTP{{.ExportedName}} serves the {{.Name}} resource.
type HTTP{{.ExportedName}} struct{}

// NewHTTP{{.ExportedName}} creates the {{.Name}} handler.
func NewHTTP{{.ExportedName}}() *HTTP{{.ExportedName}} {
	h := &HTTP{{.ExportedName}}{}

	return h
}

// Name returns the handler name.
func (h *HTTP{{.ExportedName}}) Name() string {
	return "{{.Name}}.http"
}

// Type returns the handler transport.
func (h *HTTP{{.ExportedName}}) Type() string {
	return "http"
}

// Register mounts the {{.Name}} routes.
func (h *HTTP{{.ExportedName}}) Register(router *bunrouter.Router) {
	g := router.NewGroup("/{{.Name}}"){{if .WithAuth}}.Use(validateSession){{end}}

	g.GET("/list", h.list)
	g.POST("/", h.create)
	g.GET("/:id", h.get)
	g.PUT("/:id", h.update)
	g.DELETE("/:id", h.delete)
}

