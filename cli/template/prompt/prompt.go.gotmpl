package prompt

import (
	"fmt"

	mcp "github.com/go-sicky/sicky/service/mcp"
)

type {{.ExportedName}}Prompt struct{}

func New{{.ExportedName}}Prompt() *{{.ExportedName}}Prompt {
	return &{{.ExportedName}}Prompt{}
}

func (p *{{.ExportedName}}Prompt) Name() string        { return "{{.Name}}" }
func (p *{{.ExportedName}}Prompt) Description() string { return "{{.Name}} prompt" }

func (p *{{.ExportedName}}Prompt) Tools() []mcp.Tool { return nil }
func (p *{{.ExportedName}}Prompt) CallTool(name string, args map[string]interface{}) (*mcp.ToolsCallResult, error) {
	return nil, fmt.Errorf("{{.Name}}: CallTool not implemented")
}

func (p *{{.ExportedName}}Prompt) Resources() []mcp.Resource { return nil }
func (p *{{.ExportedName}}Prompt) ReadResource(uri string) (*mcp.ResourcesReadResult, error) {
	return nil, fmt.Errorf("{{.Name}}: ReadResource not implemented")
}

func (p *{{.ExportedName}}Prompt) Prompts() []mcp.Prompt {
	return []mcp.Prompt{
		{
			Name:        "{{.Name}}",
			Description: "{{.Name}} prompt",
		},
	}
}

func (p *{{.ExportedName}}Prompt) GetPrompt(name string, args map[string]string) (*mcp.PromptsGetResult, error) {
	if name != "{{.Name}}" {
		return nil, fmt.Errorf("{{.Name}}: unknown prompt %q", name)
	}

	return &mcp.PromptsGetResult{
		Description: "{{.Name}} prompt",
		Messages: []mcp.PromptMessage{
			{
				Role: "user",
				Content: mcp.PromptContent{
					Type: "text",
					Text: "{{.Name}} prompt",
				},
			},
		},
	}, nil
}
