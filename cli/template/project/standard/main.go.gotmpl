package main

import (
	"context"
	"errors"
	"log"
{{if .Models}}	"os"
{{end}}
	"{{.Module}}/app"
{{if or .WithGRPC .WithFiber .WithHTTP}}	"{{.Module}}/handler"
{{end}}{{if .Models}}	"{{.Module}}/model"
{{end}}	"github.com/go-sicky/sicky"
{{if .Models}}	"github.com/go-sicky/sicky/infra"
	"github.com/go-sicky/sicky/logger"
{{end}}{{if or .WithGRPC .WithFiber .WithHTTP}}	"github.com/go-sicky/sicky/server"
{{end}}{{if .WithFiber}}	srvFiber "github.com/go-sicky/sicky/server/fiber"
{{end}}{{if .WithGRPC}}	srvGRPC "github.com/go-sicky/sicky/server/grpc"
{{end}}{{if .WithHTTP}}	srvHTTP "github.com/go-sicky/sicky/server/http"
{{end}}	"github.com/go-sicky/sicky/service"
	"github.com/go-sicky/sicky/service/standard"
)

var (
	AppName   = "{{.AppName}}"
	Version   = "latest"
	Branch    = "main"
	Commit    = ""
	BuildTime = ""
)

func main() {
	ctx := context.Background()

	// Sicky
	if err := sicky.Init(
		&sicky.Options{
			AppName:   AppName,
			Version:   Version,
			Branch:    Branch,
			Commit:    Commit,
			BuildTime: BuildTime,
			Context:   ctx,
{{if .Models}}			MustInfra: []string{"bun"},
{{end}}		},
{{if .Models}}		&sicky.FlagSwitch{
			Flag:     "initdb",
			Usage:    "Initialize the database tables and exit",
			Callback: initdb,
		},
{{end}}	); err != nil {
		if errors.Is(err, sicky.ErrVersionShown) {
			return
		}

		log.Fatalf("sicky: init: %v", err)
	}
	if err := sicky.ConfigUnmarshal(&config); err != nil {
		log.Fatalf("sicky: config unmarshal: %v", err)
	}

	// Application configuration. Ensure keeps the pointer non-nil even when
	// config.json carries no app block, so the middleware can read it.
	app.Config = config.App.Ensure()

{{if .WithGRPC}}	// GRPC server
	grpcSrv := srvGRPC.New(
		&server.Options{
			Name:    AppName + "@grpc",
			Context: ctx,
		},
		config.Server.GRPC,
	)
	grpcSrv.Handle(handler.New{{.ExportedName}}GRPC())

{{end}}{{if .WithFiber}}	// Fiber server
	fiberSrv := srvFiber.New(
		&server.Options{
			Name:    AppName + "@fiber",
			Context: ctx,
		},
		config.Server.Fiber,
	)
	fiberSrv.Handle(handler.New{{.ExportedName}}Fiber())

{{end}}{{if .WithHTTP}}	// HTTP server
	httpSrv := srvHTTP.New(
		&server.Options{
			Name:    AppName + "@http",
			Context: ctx,
		},
		config.Server.HTTP,
	)
	httpSrv.Handle(handler.NewHTTPHttp())
{{if .WithAuth}}	httpSrv.Handle(handler.NewHTTPAuth())
{{end}}{{range .Models}}	httpSrv.Handle(handler.NewHTTP{{.ExportedName}}())
{{end}}
{{end}}	// Service
	svc := standard.New(
		&service.Options{
			Name:    AppName,
			Context: ctx,
		},
		config.Service,
	)
{{if or .WithGRPC .WithFiber .WithHTTP}}	svc.Servers(
{{if .WithGRPC}}		grpcSrv,
{{end}}{{if .WithFiber}}		fiberSrv,
{{end}}{{if .WithHTTP}}		httpSrv,
{{end}}	)
{{else}}	// No servers selected: the service runs background jobs only.
	_ = svc
{{end}}
	// Run blocks until a signal. A non-nil error is a failed startup or an
	// incomplete teardown, so it must reach the exit status, not just the log.
	if err := sicky.Run(config.Sicky); err != nil {
		log.Fatalf("sicky: run: %v", err)
	}
}
{{if .Models}}
// initdb creates the uuid-ossp extension and every model's table, then exits
// so the process does not proceed to serve. It runs from the --initdb flag
// after infrastructure initialization.
func initdb() error {
	ctx := context.Background()

	if infra.GetBun() == nil {
		logger.Logger.FatalContext(ctx, "database connection is not initialized")
	}

	// uuid_generate_v4() comes from uuid-ossp, which a clean PostgreSQL
	// database does not have installed.
	if _, err := infra.GetBun().ExecContext(ctx, `CREATE EXTENSION IF NOT EXISTS "uuid-ossp"`); err != nil {
		return err
	}

{{range .Models}}	if err := (model.{{.ExportedName}}{}).InitDB(ctx, false); err != nil {
		return err
	}

{{end}}	os.Exit(0)

	return nil
}
{{end}}

