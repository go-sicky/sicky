package main

import (
	"github.com/go-sicky/sicky"
{{if .WithFiber}}	srvFiber "github.com/go-sicky/sicky/server/fiber"
{{end}}{{if .WithGRPC}}	srvGRPC "github.com/go-sicky/sicky/server/grpc"
{{end}}{{if .WithHTTP}}	srvHTTP "github.com/go-sicky/sicky/server/http"
{{end}}	"github.com/go-sicky/sicky/service/standard"
)

type ConfigDef struct {
	Server struct {
{{if .WithFiber}}		Fiber *srvFiber.Config `json:"fiber" yaml:"fiber" mapstructure:"fiber"`
{{end}}{{if .WithGRPC}}		GRPC  *srvGRPC.Config  `json:"grpc" yaml:"grpc" mapstructure:"grpc"`
{{end}}{{if .WithHTTP}}		HTTP  *srvHTTP.Config  `json:"http" yaml:"http" mapstructure:"http"`
{{end}}	} `json:"server" yaml:"server" mapstructure:"server"`
	Service *standard.Config `json:"service" yaml:"service" mapstructure:"service"`
	Sicky   *sicky.Config    `json:"sicky" yaml:"sicky" mapstructure:"sicky"`
}

var config ConfigDef
