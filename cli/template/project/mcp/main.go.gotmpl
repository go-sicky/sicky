package main

import (
	"errors"
	"log"
	"context"

	"{{.Module}}/handler"
	"github.com/go-sicky/sicky"
{{if or .WithFiber .WithHTTP}}	"github.com/go-sicky/sicky/server"
{{end}}{{if .WithFiber}}	srvFiber "github.com/go-sicky/sicky/server/fiber"
{{end}}{{if .WithHTTP}}	srvHTTP "github.com/go-sicky/sicky/server/http"
{{end}}	"github.com/go-sicky/sicky/service"
	mcp "github.com/go-sicky/sicky/service/mcp"
)

var (
	AppName   = "{{.AppName}}"
	Version   = "latest"
	Branch    = "main"
	Commit    = ""
	BuildTime = ""
)

func main() {
	ctx := context.Background()

{{if or .WithFiber .WithHTTP}}	if err := sicky.Init(
		&sicky.Options{
			AppName:   AppName,
			Version:   Version,
			Branch:    Branch,
			Commit:    Commit,
			BuildTime: BuildTime,
			Context:   ctx,
		},
	); err != nil {
		if errors.Is(err, sicky.ErrVersionShown) {
			return
		}

		log.Fatalf("sicky: init: %v", err)
	}

	if err := sicky.ConfigUnmarshal(&config); err != nil {
		log.Fatalf("sicky: config unmarshal: %v", err)
	}

{{if .WithFiber}}	fiberSrv := srvFiber.New(
		&server.Options{
			Name:    AppName + "@fiber",
			Context: ctx,
		},
		config.Server.Fiber,
	)
	fiberSrv.Handle(handler.New{{.ExportedName}}Fiber())

{{end}}{{if .WithHTTP}}	httpSrv := srvHTTP.New(
		&server.Options{
			Name:    AppName + "@http",
			Context: ctx,
		},
		config.Server.HTTP,
	)
	httpSrv.Handle(handler.New{{.ExportedName}}HTTP())

{{end}}	svc := mcp.New(
		&service.Options{
			Name:    AppName,
			Version: Version,
			Context: ctx,
		},
		config.Service,
	)

	svc.Servers(
{{if .WithFiber}}		fiberSrv,
{{end}}{{if .WithHTTP}}		httpSrv,
{{end}}	)
	svc.Handle(handler.New{{.ExportedName}}())

	// Run blocks until a signal. A non-nil error is a failed startup or an
	// incomplete teardown, so it must reach the exit status, not just the log.
	if err := sicky.Run(config.Sicky); err != nil {
		log.Fatalf("sicky: run: %v", err)
	}
{{else}}	// Pure stdio transport: no config file, no logs on stdout.
	if err := sicky.Init(
		&sicky.Options{
			AppName:       AppName,
			Version:       Version,
			Branch:        Branch,
			Commit:        Commit,
			BuildTime:     BuildTime,
			Context:       ctx,
			DisableConfig: true,
			Silence:       true,
		},
	); err != nil {
		if errors.Is(err, sicky.ErrVersionShown) {
			return
		}

		log.Fatalf("sicky: init: %v", err)
	}

	svc := mcp.New(
		&service.Options{
			Name:    AppName,
			Version: Version,
			Context: ctx,
		},
		config.Service,
	)

	svc.Handle(handler.New{{.ExportedName}}())

	// Run blocks until a signal. A non-nil error is a failed startup or an
	// incomplete teardown, so it must reach the exit status, not just the log.
	if err := sicky.Run(config.Sicky); err != nil {
		log.Fatalf("sicky: run: %v", err)
	}
{{end}}}

