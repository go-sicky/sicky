package handler

import (
	"github.com/go-sicky/sicky/utils"
	"github.com/gofiber/fiber/v3"
)

type {{.ExportedName}}Fiber struct{}

func New{{.ExportedName}}Fiber() *{{.ExportedName}}Fiber {
	h := &{{.ExportedName}}Fiber{}

	return h
}

func (h *{{.ExportedName}}Fiber) Name() string {
	return "{{.Name}}.fiber"
}

func (h *{{.ExportedName}}Fiber) Type() string {
	return "fiber"
}

func (h *{{.ExportedName}}Fiber) Register(app *fiber.App) {
	app.Get("/ping", h.ping).Name("{{.ExportedName}}GetPing")
}

/* ===== [Fiber handlers] ===== */
func (h *{{.ExportedName}}Fiber) ping(c fiber.Ctx) error {
	return c.JSON(utils.WrapHTTPResponse(map[string]string{
		"message": "pong",
	}))
}

/* ===== [/Fiber handlers] ===== */

