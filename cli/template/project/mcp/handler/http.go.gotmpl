package handler

import (
	"net/http"

	"github.com/uptrace/bunrouter"
)

type {{.ExportedName}}HTTP struct{}

func New{{.ExportedName}}HTTP() *{{.ExportedName}}HTTP {
	h := &{{.ExportedName}}HTTP{}

	return h
}

func (h *{{.ExportedName}}HTTP) Name() string {
	return "{{.Name}}.http"
}

func (h *{{.ExportedName}}HTTP) Type() string {
	return "http"
}

func (h *{{.ExportedName}}HTTP) Register(router *bunrouter.Router) {
	router.GET("/ping", h.ping)
}

/* ===== [HTTP handlers] ===== */
func (h *{{.ExportedName}}HTTP) ping(w http.ResponseWriter, _ bunrouter.Request) error {
	return bunrouter.JSON(w, bunrouter.H{
		"message": "pong",
	})
}

