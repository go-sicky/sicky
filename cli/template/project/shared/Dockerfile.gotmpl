# Generated by `sicky new`: multi-stage build for the scaffolded service.
# `make docker` depends on this file; plain tags resolve to docker.io
# by default (no registry prefix). Retag for private registries, e.g.:
#   docker tag {{.Name}}:main <registry>/{{.Name}}:main
FROM golang:1.26-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=latest
ARG BRANCH=main
ARG COMMIT_SHA=unknown
ARG BUILD_TIME=unknown
RUN CGO_ENABLED=0 go build -a -installsuffix cgo \
	-ldflags "-s -w -extldflags \"-static\" \
	-X \"main.Version=${VERSION}\" \
	-X \"main.Branch=${BRANCH}\" \
	-X \"main.BuildTime=${BUILD_TIME}\" \
	-X \"main.Commit=${COMMIT_SHA}\" \
	-X \"main.AppName={{.AppName}}\"" \
	-o /out/svc .

FROM alpine:3.20
WORKDIR /app
COPY --from=builder /out/svc /app/svc
COPY config.json /app/config.json
EXPOSE{{if .WithFiber}} 3000{{end}}{{if .WithHTTP}} 9980{{end}}{{if .WithGRPC}} 44945{{end}} 8888
ENTRYPOINT ["/app/svc"]
