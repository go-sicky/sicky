FROM golang:1.26-alpine AS builder
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -ldflags '-s -w' -o /out/svc .

FROM alpine:3.20
WORKDIR /app
COPY --from=builder /out/svc /app/svc
COPY config.json /app/config.json
EXPOSE 3000 8888
ENTRYPOINT ["/app/svc"]
