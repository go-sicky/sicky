package main

import (
	"errors"
	"log"
	"context"

	"{{.Module}}/handler"
	"github.com/go-sicky/sicky"
	"github.com/go-sicky/sicky/service"
	"github.com/go-sicky/sicky/service/interactive"
)

var (
	AppName   = "{{.AppName}}"
	Version   = "latest"
	Branch    = "main"
	Commit    = ""
	BuildTime = ""
)

func main() {
	ctx := context.Background()

	if err := sicky.Init(
		&sicky.Options{
			AppName:   AppName,
			Version:   Version,
			Branch:    Branch,
			Commit:    Commit,
			BuildTime: BuildTime,
			Context:   ctx,
		},
	); err != nil {
		if errors.Is(err, sicky.ErrVersionShown) {
			return
		}

		log.Fatalf("sicky: init: %v", err)
	}

	if err := sicky.ConfigUnmarshal(&config); err != nil {
		log.Fatalf("sicky: config unmarshal: %v", err)
	}

	svc := interactive.New(
		&service.Options{
			Name:    AppName,
			Context: ctx,
		},
		config.Service,
	)
	svc.Handle(handler.New{{.ExportedName}}())

	// Run blocks until a signal. A non-nil error is a failed startup or an
	// incomplete teardown, so it must reach the exit status, not just the log.
	if err := sicky.Run(config.Sicky); err != nil {
		log.Fatalf("sicky: run: %v", err)
	}
}
